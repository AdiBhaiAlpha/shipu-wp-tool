# ShiPu WP - environment template
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.
# `.env.example` must contain placeholders only.

# ---------------------------------------------------------------------------
# Endpoints
# ---------------------------------------------------------------------------
# Backend (Render Web Service) that owns privileged operations.
# Leave empty to run the tool fully offline in prototype mode.
SHIPU_API_URL=

# Public website (Render Static Site). Used to build trusted purchase links.
SHIPU_WEB_URL=

# ---------------------------------------------------------------------------
# Firebase client config (safe to expose - these are public client identifiers)
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# AI gateway (PHASE 11)
# ---------------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Configurable pricing (idea.txt item 5 - never hard-code prices in the UI)
# ---------------------------------------------------------------------------
SHIPU_FREE_DAILY_REPLIES=25
SHIPU_PRO_DAILY_REPLIES=0
SHIPU_PRO_PRICE_CENTS=0
SHIPU_PRO_CURRENCY=USD
SHIPU_PRO_DURATION_DAYS=30

# ---------------------------------------------------------------------------
# Backend secrets - SERVER ONLY (Render dashboard), never in this file's
# committed template and never read by the Termux tool.
# The tool refuses to start if any of these appear in its environment.
# ---------------------------------------------------------------------------
# FIREBASE_ADMIN_CREDENTIALS=
# PAYMENT_SECRET=
# WEBHOOK_SECRET=
# ADMIN_BOOTSTRAP_UIDS=