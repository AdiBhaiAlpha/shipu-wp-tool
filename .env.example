# Copy to .env and fill in. .env is git-ignored.

# Backend API (Render). Leave empty for local-only mode.
SHIPU_API_URL=
SHIPU_WEB_URL=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-26b:free
OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,qwen/qwen3.8-27b:free

# Pricing
SHIPU_FREE_DAILY_REPLIES=25
SHIPU_PRO_DURATION_DAYS=30
SHIPU_PRO_PRICE_CENTS=1200
SHIPU_PRO_CURRENCY=USD
